# Strict allowlist: keep the Docker build context limited to files required to
# assemble and run the PAUSE image. Everything else is excluded by default.
**

!Dockerfile
!.dockerignore
!nginx.conf
!start-script.sh

!index.html
!favicon.svg
!LICENSE
!LICENSE-CONTENT.md

!pages/
!pages/*.html

!css/
!css/*.css

!js/
!js/*.js

!data/
!data/site.json
!data/pages/
!data/pages/*.json
!data/content/
!data/content/*.md
!data/instrument/
!data/instrument/*.json

!fonts/
!fonts/*.woff2
!fonts/OFL-*.txt

!media/
!media/figure1-theoretical-framework.png
!media/item-b5-anatomy.png
!media/compare-chart.png
!media/compare-deltas.png
!media/offloading-pattern-demo.png
!media/compare-demo.png
!media/compare-narrated-analysis.png
